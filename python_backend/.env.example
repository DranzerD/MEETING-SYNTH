# Copy to .env (or export in your shell) and fill in.

# --- Conversational query LLM (POST /query and the optional use_llm pass
# in /analyze). Only ONE of these is required -- chat_complete() tries
# Groq first, then falls back to OpenAI, then Anthropic, based on
# whichever key(s) are set. ---
GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant   # override if you want a different Groq model
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Embeddings ---
# Any sentence-transformers model name. all-MiniLM-L6-v2 (384-dim) is the
# default: small, fast on CPU, no API key needed. First run downloads it
# from huggingface.co (~80MB) and caches it locally. Changing this after
# meetings are already indexed requires a full re-index -- the old and
# new vectors are not comparable.
# AURA_EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Chunking (see aura_core/chunking.py) ---
# AURA_CHUNK_SIZE_WORDS=180
# AURA_CHUNK_OVERLAP_SENTENCES=2

# --- Retrieval (see aura_core/retrieval.py, query_engine.py) ---
# Default top_k for /query when the request doesn't specify one.
# AURA_TOP_K=5
# Below this cosine similarity, /query refuses to answer instead of
# grounding a response in a weak match. See rag_eval/ for how this was
# calibrated and results/retrieval_eval.json for the measured score
# separation between relevant and irrelevant queries.
# AURA_MIN_RELEVANCE_SCORE=0.30

# --- Reranking (see aura_core/reranking.py) ---
# Cross-encoder reranking over an over-fetched ANN candidate pool. Adds
# real latency (~100-150ms measured locally, see
# results/retrieval_benchmark.json) in exchange for better top-k
# ordering (see results/retrieval_eval.json for the measured difference).
# AURA_ENABLE_RERANKING=true
# AURA_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# AURA_RERANK_CANDIDATES=20

# --- Storage locations ---
# Override if you want the Chroma collection or cache/ledger files
# somewhere other than python_backend/{chroma_db,cache}/ -- e.g. to run
# multiple local checkouts side by side, or in a container with a mounted
# volume.
# AURA_CHROMA_DIR=./chroma_db
# AURA_CACHE_DIR=./cache
