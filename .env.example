# Copy to .env.local and fill in.

# Existing (unchanged) --------------------------------------------------
MONGODB_URI=mongodb://localhost:27017/meetingsynth
AURA_PY_API_URL=http://localhost:8000

# Session signing key for auth (src/app/lib/auth.ts). Sessions are a
# stateless HMAC-signed cookie, so this secret is what makes them
# unforgeable -- generate a real random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this invalidates every existing session (forces re-login).
SESSION_SECRET=

# The RAG layer (chat, background indexing) lives entirely in
# python_backend -- there is nothing new to configure here. Its env vars
# are in python_backend/.env.example.
