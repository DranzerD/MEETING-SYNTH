# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!python_backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
python_backend/.venv
python_backend/__pycache__
python_backend/**/__pycache__
python_backend/.pytest_cache
python_backend/cache/
python_backend/output/
# python_backend/results/ is intentionally NOT ignored: it holds the
# benchmark/eval JSON that backs the numbers in README.md. Regenerate with
# benchmark.py / benchmark_retrieval.py / rag_eval, and commit the update.

# RAG data (generated locally -- chunks/embeddings live in Chroma, not git)
python_backend/chroma_db/

# meeting data saved by /api/analyze (local JSON store)
/data/meetings
